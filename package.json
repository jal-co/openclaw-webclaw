{
  "name": "@jalco/openclaw-webclaw",
  "version": "0.1.4",
  "description": "OpenClaw plugin that replaces the bundled Firecrawl plugin with native WebClaw v1 API support",
  "repository": {
    "type": "git",
    "url": "https://github.com/jal-co/openclaw-webclaw"
  },
  "license": "AGPL-3.0",
  "type": "module",
  "dependencies": {
    "typebox": "^1.1.37"
  },
  "devDependencies": {
    "typescript": "^5.8.0"
  },
  "peerDependencies": {
    "openclaw": ">=2026.5.7"
  },
  "peerDependenciesMeta": {
    "openclaw": {
      "optional": true
    }
  },
  "main": "dist/index.js",
  "openclaw": {
    "extensions": [
      "./src/index.ts"
    ],
    "runtimeExtensions": [
      "./dist/index.js"
    ],
    "install": {
      "npmSpec": "@jalco/openclaw-webclaw",
      "defaultChoice": "npm"
    },
    "compat": {
      "pluginApi": ">=2026.5.7",
      "minGatewayVersion": "2026.5.7"
    },
    "build": {
      "openclawVersion": "2026.5.7"
    }
  },
  "scripts": {
    "build": "tsc --outDir dist --rootDir src --target ES2022 --module Node16 --moduleResolution Node16 --esModuleInterop --skipLibCheck --noCheck --declaration false"
  },
  "files": [
    "dist/**",
    "src/**",
    "openclaw.plugin.json"
  ]
}
